        <PAGEOBJECT XPOS="413.937637795276" YPOS="544.410708661417" OwnPage="0" ItemID="98228256" PTYPE="4" WIDTH="524.409448818898" HEIGHT="19.8425196850394" FRTYPE="0" CLIPEDIT="0" ROT="270" PWIDTH="1" PCOLOR="Black" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" TransValue="0.2" path="M0 0 L524.409 0 L524.409 19.8425 L0 19.8425 L0 0 Z" copath="M0 0 L524.409 0 L524.409 19.8425 L0 19.8425 L0 0 Z" gXpos="416.937637795276" gYpos="544.410708661417" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
