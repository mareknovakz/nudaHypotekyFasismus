        <PAGEOBJECT XPOS="120.774823469647" YPOS="38.2886498718452" OwnPage="0" ItemID="197856224" PTYPE="4" WIDTH="278.491236982474" HEIGHT="404.074814695084" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L278.491 0 L278.491 404.075 L0 404.075 L0 0 Z" copath="M0 0 L278.491 0 L278.491 404.075 L0 404.075 L0 0 Z" gXpos="120.774823469647" gYpos="38.2886498718452" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Amiri Italic" FONTSIZE="12" FCOLOR="White" FSHADE="100" SCALEH="100" CH="Mirek Mrkvička ve svém literárním debutu Nuda, hypotéky, fašismus představuje koncept „hypotečního realismu“. Sbírka nabízí syrový pohled na realitu současné společnosti, pro kterou se třicetiletý úvěr na bydlení stal často jediným skutečným smyslem existence. Kniha zachycuje svět excelových tabulek, nedělních nákupů a předměstské letargie, pod jejímž povrchem nenápadně, ale vytrvale bují frustrace. Mrkvička ukazuje svět, který se z každodenní ubíjející rutiny a lhostejnosti postupně radikalizuje, a dochází k závěru, že v každém znás je kousek fašismu."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="414.109677419355" YPOS="210.426456692913" OwnPage="0" ItemID="96505520" PTYPE="4" WIDTH="165.946070612141" HEIGHT="18.5993395986792" FRTYPE="0" CLIPEDIT="1" ROT="270" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L165.946 0 L165.946 18.5993 L0 18.5993 L0 0 Z" copath="M0 0 L165.946 0 L165.946 18.5993 L0 18.5993 L0 0 Z" gXpos="414.109677419355" gYpos="210.426456692913" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
