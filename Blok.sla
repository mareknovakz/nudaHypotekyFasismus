        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="3371.416" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="12" ItemID="2012" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Pan Pták si vzal sick day"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták si vzal sick day,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="má cystu na ledvině,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="myslel, že má kameny."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pod nánosy hlíny"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ptákova matka spí."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pospěšme k místu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="kde zaměstnanci spí."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ptákova milá"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="na ostrově kočárků spí,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nevzala si sick day."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Z kostí padlých"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="pěstujeme nové kancly."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták má cystu ve výkazu práce."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Sedí doma, nahmatává si bulky."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Většinou nejsou zhoubné."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pod nánosy hlíny"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ptákova matka spí."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Doktor Ptákovu cystu prohlíží."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Hmatá, lechtá, hledá ledvinu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Cysta svědí, pálí, čas letí."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan šéf čeká, doufá,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="_snad je to jen cysta._"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták je příliš mladý,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="aby si ustlal pod hlínou."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták má cystu a zánět svědomí."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="3791.652" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="13" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
