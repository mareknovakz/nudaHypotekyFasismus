        <PAGEOBJECT XPOS="476.811" YPOS="2270.944" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="8" ItemID="2008" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Wine culture"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="_Čas strávený ve vinném sklípku se nepočítá do života._"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="_Co je to život?_"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Sestoupil jsem v Letňanech, abych to zjistil."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Letňanské předměstí lemují bílé"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="rodinné domky, bílé jako jejich domácí,"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="tam žije Marie Alice,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nakoupí v Tescu, vypere prádlo,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="pověsí prádlo, vyžehlí prádlo,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="podusí osso buco, udělá šafránové rizoto,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="uzavře životní pojistku, uklidí dům,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="vyčistí hlaveň u revolveru, přebalí batole,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="zalije petržel, přesadí orchideje,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="do dětského pokoje vybere nové barvy,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="pak se revolverem střelí do hlavy."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Tomáš Novotný si ráno uváže kravatu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nasedne do BMW X5, odjede do pojišťovny,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="zamítne několik plnění, sjedná pojištění flotily"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="zahrnující sedm fabií."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Doma sleduje Netflix,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jacka Danielse zapíjí Kozlem,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="protože jeho dcera strčila hlavu do igelitky,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nemohla ji vytáhnout a udusila se."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Mladý pán, alfa samec Koudelka,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="chodí do gymu dvakrát denně,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="pije pouze proteinovo-banánové shaky,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="z vrtulníku by vyházel všechny levičáky."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Instagram zaplňuje bonmoty,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="jeho přátelé jsou kokoti."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Chtěl, aby černochy prodávali na pouti."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jednou mu sklouzne bench a rozdrtí si krkovici,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="těsně před smrtí si uvědomí, že je na kluky."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Slavnosti vína na Grébovce:"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="štangle sušené zvířecí tkáně,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="sudy s pivem, koše plné tácků"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="umaštěných od hořčice, kuřata plná salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Opodál stojí ramenatý cirkusák."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Oblečen v gepardím trikotu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="cpe si do krku bochníky chleba"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="a celé je polyká – pro pobavení."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pátrání po smyslu života:"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="_Pravda je ve víně_"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="– Wine culture."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Novotní mají ve vaně delfína,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="ocasem mlátí a sprostě nadává."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Dneska bude dršťková, už se vaří kedluben."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Máma pláče, že nejsou dost bohatí."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Táta odešel pro mléko, už se nevrátí."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Michal Pokorný nepil,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nekouřil, nemyl se, nejedl,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nešukal, nehrál, nesvítil,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="netopil, nesurfoval."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jen pracoval a šetřil na pohřeb."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Děti ho uložily do hromadného"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="hrobu, co vznikl během covidu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="peníze utratily za Labubu."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Emo Ema se řeže,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="ránu si ošetří dezinfekcí, bojí se infekcí."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Eko Erika nakupuje bezobalově a nejí maso,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="na Bali létá první třídou,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="zemře hanebnou bídou."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Bio Pepa šňupe pouze naturální piko."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Slavnosti vína na Grébovce:"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="nudou, životem a prací zničení otcové litující svých hypoték"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="a promarněného mládí, mírně opilé matky"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="neschopné již čehokoliv litovat,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="otčímové, kteří nevlastní děti"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="oslovují jménem, přestože je živí a"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="předstírají, že je mají rádi, jako by byly jejich vlastní,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="milenky otců, o kterých matky tuší,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="milenky matek, po kterých otcové touží."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Nejváženější členové domácnosti"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="české národní zvíře – pes."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Psi serou na každém rohu a lížou si koule."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Plastové kelímky s vínem dováženým z Moravy,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="které na Moravě nikdo nechce pít."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="A děti."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="– White culture."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="2691.18" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="9" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="9" CH="10"/>
                <para ALIGN="1"/><trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="2270.944" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="9" ItemID="2009" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Anemoia"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jako děti jsme bydleli na sídlišti"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="mezi poli koberců"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="a cestovali po planetách"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="vyšitých na černé dece."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Bylo snadné skočit z Merkuru na Jupiter,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="prolézt černou dírou až k Plutu,"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="tehdy bylo ještě planetou."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pak nás máma zavolala k obědu"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="a svět držel pohromadě."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Možná si to jen takhle pamatuji."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
