        <PAGEOBJECT XPOS="145" YPOS="10524.484" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="39" ItemID="2039" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Zítra byl pěkný den"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ve čtvrtek se mi zdálo, že mám pusu plnou hmyzu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Obědval jsem v práci za stravenky."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Rád si gumičkama cvrnkám do zápěstí, štípe to."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Z technických důvodů jsem se musel na hodinu zdržet."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Popovídal jsem si se všemi vnitřními hlasy."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jak chutná hlava kudlanky nábožné?"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Včera se mi zdálo, že mám pusu plnou hmyzu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="K obědu jsem si dal srbské rizoto."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zapomněli na kyselou okurku."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="V práci se nestalo nic, co by stálo za zmínku."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Večer jsem se schoval pod postel a tam usnul."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Co kdybych měl komára v nose?"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Dnes se mi zdálo, že mám pusu plnou hmyzu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Vynesl jsem odpadky, prokopnul dveře, vyzvednul poštu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Vzpomněl jsem si na neustlanou postel a bylo mi to jedno."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="V parku jsem schválně vyplašil hejno holubů."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Byl to pěkný den."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Co kdybych ten hmyz všechen spolykal?"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zítra se mi zdálo, že mám pusu plnou hmyzu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Obědval jsem v práci za stravenky."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="K obědu jsem si dal srbské rizoto."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Vynesl jsem odpadky, prokopnul dveře, vyzvednul poštu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zapomněli na kyselou okurku."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Co kdybych měl pusu plnou hmyzu?"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="11494.956" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="40" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="9" CH="41"/>
                <para ALIGN="1"/><trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="11074.72" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="40" ItemID="2040" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Preventivní prohlídka"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pověz mi tajemství, které znají všichni nemocní."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zakašli mi ho do ucha."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Proceď ho mezi zuby,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="jen trochu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="tak aby sis nepoškrábal jazyk."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Neboj se, že pak ztratí něco na obsahu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="neboj se, že pak ztratí ze sebe něco hřejivého,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="stejně asi dávno tuším."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zakašli mi ho, až se budeš víc bát."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Kašel je dalším jazykem."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jazykem, kterým se sdělují trochu jiné zkušenosti."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Zakašli mi ho, až se přestanu ptát."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pověz mi ho zítra večer na hřbitově,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="až budeme kopat těla, pak jim spočítáme zdravé zuby."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Nesnáším český zdravotní systém."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="11494.956" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="41" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="9" CH="42"/>
                <para ALIGN="1"/><trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="11074.72" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="41" ItemID="2041" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Podává se koliva"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jak plíseň na chodidlech,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="šíří se zvěst o Göhrově nemoci."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jak Zarathustra v jeskyni"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="starý Göhr je uzavřen v pracovně."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Tvrdý vřed, na plicích krev, zduřelé uzliny,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="tři promile v krvi."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Göhr ví,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="co ho čeká,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="kolem domu se sbíhají černé kočky."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na varlatech condylomata lata,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="v kuchyni se chystá koliva."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="O Göhrových bolestech už služebnictvo ví."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Nikdy netrpěl pro blaho státu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="starý Göhr v ruce nedržel lopatu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Nezničil ho pracovní shon,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="mozoly na dlaních ani dna."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Göhr nezemře na stáří, bídu;"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="starý Göhr zemře na syfilitidu."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="12045.192000000001" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="42" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="9" CH="43"/>
                <para ALIGN="1"/><trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="11624.956" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="42" ItemID="2042" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Pan Pták si dělá zbrojní průkaz"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták slaví killdozer day,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="rozpaluje olej, smaží nugety."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták mluví pozpátku."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jeho milá na ostrově kočárků spí,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="o spravedlnosti se jí nezdá,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="netouží po společnosti."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták si hraje se žlutým hadem,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="jeho milá se koupe."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták slyší hlasy,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="mluví k němu Bůh,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="v hlavě si hraje s hadem."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták mluví s předky."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták si dělá zbrojní průkaz,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="chce zastřelit zloděje."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták chce zastřelit komunistu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="má cystu na mozku."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Pan Pták nechce platit daně."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jeho milá na ostrově kočárků spí,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="utopila se ve vaně."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="12175.192" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="44" ItemID="2044" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
