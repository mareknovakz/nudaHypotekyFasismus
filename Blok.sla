        <PAGEOBJECT XPOS="476.811" YPOS="10524.484" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="38" ItemID="2038" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Dort, který jíme, když někdo umře"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na talířích jsou těla bakterií salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Schováváme si je na horší časy."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="A v horších časech si je přidáváme do mléka z vody,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="z něhož pak pečeme kolivu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Kolivu vaříme z mléka z bahnité vody s bakteriemi salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Dort, který jíme, když někdo umře."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Nesnáším, když pečeme kolivu napřed."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Kravské mléko si necháváme jen na příležitost narození."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na talířích jsou pak těla bakterií salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Do kravského mléka pak přidáváme živé bakterie salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Infikované mléko pijeme a pijem a nepijem, jen když se nadechujem."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Je pak více příležitostí péct kolivu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na talířích jsou těla bakterií salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="A my z nich pak vaříme kolivu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="dort, který jíme, když někdo umře."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Kostmi krmíme staré slepice."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Dřív jsme je házeli i kohoutům, ale ti tuší."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Slepice také tuší, ale neslyší."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Před každým jídlem pak parodujem Piláta."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Myjeme si ruce,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="ruce od krve, myjeme si je od kuřecích hříchů."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ruce si myjeme."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Myjeme si je, aby nebyly moc čisté."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na talířích jsou těla bakterií salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="A my z nich pak vaříme kolivu,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="dort, který jíme, když někdo umře."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Na talířích jsou těla bakterií salmonely."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Těla bakterií salmonely jsou na talíři."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="A pak pečeme kolivu."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Kolivu pak pečeme."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="10944.720000000001" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="39" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
