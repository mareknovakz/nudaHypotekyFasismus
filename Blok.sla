                <ITEXT FONT="Courier Prime" FONTSIZE="20" CH="PTAČÍ REPUBLIKA"/>
                <para ALIGN="1" VOR="150"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="145" YPOS="12595.428" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="45" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
