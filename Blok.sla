        <PAGEOBJECT XPOS="476.811" YPOS="1170.472" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="4" ItemID="2004" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="12" CH="Kde ztratili víru v Boha, nacházejí poslední útočiště v hypotéce. A kde na ni nedosáhnou, tam bují fašismus."/>
                <para ALIGN="1" VOR="120"/>
                <trail ALIGN="0"/>
