        <PAGEOBJECT XPOS="145" YPOS="2821.18" WIDTH="201.81099999999998" HEIGHT="410.236" OwnPage="11" ItemID="2011" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <path value="M0 0 L201.81099999999998 0 L201.81099999999998 410.236 L0 410.236 L0 0 Z"/>
            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Interclass"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="„Já tě vezmu na nádraží, abys viděl, jak dopadají lidi, kteří to chtěli jen zkusit,“ řekla paní ve středních letech svému sotva šestiletému synovi."/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="„Dobrý den, madam, směl bych vás pozvat na meeting vedení First International Bank, abyste věděla, jak dopadají lidi, kteří to jen zkoušejí?“"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="3791.652" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="12" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
