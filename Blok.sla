            <StoryText><DefaultStyle/>
                <ITEXT FONT="Courier Prime" FONTSIZE="16" CH="Prsty lžou"/>
                <para ALIGN="0" NACH="23"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Mám deset prstů,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="když je vztyčím, je jich deset."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jeden po druhém je dávám dolů"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="odpočítávám."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Deset"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="devět"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="osm"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="sedm"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="šest."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Šest?"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Šest, ale vztyčených jich mám pět."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Jak je to možné?"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Prsty lžou!"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Vezmu sekáček,"/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="ten prolhaný musí pryč."/>
                <para ALIGN="0"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="10" CH="Ale který to byl?"/>
                <para ALIGN="0"/>
                <para ALIGN="0" NACH="10"/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.811" YPOS="10944.720000000001" WIDTH="201.81099999999998" HEIGHT="20" OwnPage="38" PTYPE="4" FRTYPE="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1" COLUMNS="1" COLGAP="0">
            <StoryText><DefaultStyle/>
