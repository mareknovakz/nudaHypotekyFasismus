                <ITEXT FONT="Courier Prime" FONTSIZE="11" CH="    Kachny .... 48"/>
                <para ALIGN="0" NACH="5"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="11" CH="    Holubi a vrány .... 49"/>
                <para ALIGN="0" NACH="5"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="11" CH="    Holubi se nepoznají v zrcadle .... 50"/>
                <para ALIGN="0" NACH="5"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="11" CH="    Vrány byly toho rána neklidné .... 51"/>
                <para ALIGN="0" NACH="5"/>
                <ITEXT FONT="Courier Prime" FONTSIZE="11" CH="VNITŘNÍ FAŠISMUS .... 53"/>
                <para ALIGN="0" NACH="5"/>
